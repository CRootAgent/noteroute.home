<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_model_pill"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="10dp"
    android:paddingVertical="4dp">

    <!-- Blue circle with citation number -->
    <FrameLayout
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:background="@drawable/bg_citation_circle">

        <TextView
            android:id="@+id/tv_citation_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_citation_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="@color/slate_200"
        android:textSize="11sp"
        tools:text="Slide_Bab3_Distributed_Systems.pdf : Hal 14" />
</LinearLayout>
