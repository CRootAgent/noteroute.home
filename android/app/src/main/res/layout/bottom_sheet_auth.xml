<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B2028"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_model_pill"
        android:backgroundTint="@color/slate_700" />

    <!-- Auth Title & Subtitle -->
    <TextView
        android:id="@+id/tv_auth_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Masuk ke NoteRoute"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_auth_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Akses notebook, dokumen laptop, &amp; router AI tersinkronisasi"
        android:textColor="@color/slate_400"
        android:textSize="12sp" />

    <!-- Auth Mode Switcher Tabs (Masuk vs Daftar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_card"
        android:backgroundTint="#14171D"
        android:orientation="horizontal"
        android:padding="3dp">

        <TextView
            android:id="@+id/btn_tab_login"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_user"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Masuk Akun"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_tab_register"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="Daftar Akun Baru"
            android:textColor="@color/slate_400"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Form Input Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Name Field (Visible on Register) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nama Lengkap"
            android:textColorHint="@color/slate_400"
            android:visibility="gone"
            app:boxStrokeColor="@color/primary_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_auth_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- NPM Field (Visible on Register) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_npm"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="NPM / NIK (Opsional)"
            android:textColorHint="@color/slate_400"
            android:visibility="gone"
            app:boxStrokeColor="@color/primary_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_auth_npm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email Field -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Alamat Email (ULBI / Umum)"
            android:textColorHint="@color/slate_400"
            app:boxStrokeColor="@color/primary_light">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_auth_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="Kata Sandi"
            android:textColorHint="@color/slate_400"
            app:boxStrokeColor="@color/primary_light"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/slate_400">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_auth_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_auth"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:text="Masuk Akun"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_auth"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="Batal"
            android:textColor="@color/slate_300"
            app:cornerRadius="14dp"
            app:strokeColor="#2E343E" />
    </LinearLayout>

</LinearLayout>
