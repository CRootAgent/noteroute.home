<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B2028"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_model_pill"
        android:backgroundTint="@color/slate_700" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pilih Sumber Rujukan AI"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grounding Context"
            android:textColor="@color/slate_400"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_source_checkboxes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical">

        <!-- Checkbox 1 -->
        <CheckBox
            android:id="@+id/cb_source_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:checked="true"
            android:padding="8dp"
            android:text="Slide_Bab3_Distributed_Systems.pdf"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <!-- Checkbox 2 -->
        <CheckBox
            android:id="@+id/cb_source_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:checked="true"
            android:padding="8dp"
            android:text="Catatan_Riset_Multi_LLM.md"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <!-- Checkbox 3 -->
        <CheckBox
            android:id="@+id/cb_source_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_rounded_card"
            android:checked="true"
            android:padding="8dp"
            android:text="Modul_Praktikum_Cloud_ULBI.docx"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <!-- Checkbox 4 -->
        <CheckBox
            android:id="@+id/cb_source_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_card"
            android:checked="true"
            android:padding="8dp"
            android:text="llmRouterService.js"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_apply_source_picker"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/primary"
        android:text="Terapkan Sumber"
        android:textColor="@color/white" />

</LinearLayout>
