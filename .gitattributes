# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.properties text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Gradle wrappers
gradlew text eol=lf
gradlew.bat text eol=crlf

# Binary files - Do not modify line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
*.docx binary
