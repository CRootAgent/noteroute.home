# ==============================================================================
# NOTEROUTE UNIVERSAL .GITIGNORE (ANTI-BENTROK: NODE.JS + ANDROID + OS + SECRETS)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 2. Environment Variables & Secrets (JANGAN PERNAH DI-COMMIT!)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# ------------------------------------------------------------------------------
# 3. Android & Gradle (Domain Izat)
# ------------------------------------------------------------------------------
# Built application files
*.apk
*.aab
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java/Kotlin class files
*.class

# Generated files
bin/
gen/
out/
android/**/build/
android/.gradle/
.gradle/
build/

# Local configuration file (sdk.dir, etc.)
local.properties

# Proguard / R8 folder generated by Eclipse / Gradle
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio & IntelliJ project files
*.iml
.idea/
.idea/libraries
.idea/modules.xml
.idea/workspace.xml
.idea/caches
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Keystore files (Sangat Rahasia - Simpan di GitHub Secrets!)
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
android/**/.externalNativeBuild
android/**/.cxx

# Google Services (if applicable)
google-services.json

# ------------------------------------------------------------------------------
# 4. Node.js & Express (Domain Zakky)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul / Jest
coverage/
*.lcov
.nyc_output

# Temporary folder for uploads
uploads/
temp/
tmp/

# ------------------------------------------------------------------------------
# 5. Editor & Tooling Caches
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
.kotlin/
