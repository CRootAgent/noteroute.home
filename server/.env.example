PORT=3000
NODE_ENV=development

# 1. MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://noteroute_admin:supersecret@noteroute-cluster.mongodb.net/noteroute?retryWrites=true&w=majority

# 2. Google Gemini 1.5 Flash (Gratis 1.500 req/hari, 1 Juta Token Context)
GEMINI_API_KEY=AIzaSyD-YourGeminiApiKeyHere

# 3. Groq Cloud Llama 3.3 70B (Fast Inference Tier)
